# Public Supabase configuration. Never use a service_role key in the browser.
# If omitted, the existing MoveSmart project's public configuration is retained.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-or-publishable-key"

# Optional. Audience measurement is consent-gated; set to "false" to remove the
# consent banner and all traffic measurement from the public site.
VITE_ANALYTICS_ENABLED="true"
